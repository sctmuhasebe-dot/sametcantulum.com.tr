---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

const uzmanlikAlanlari = [
  { icon: "💼", title: "Mali Müşavirlik & Muhasebe", desc: "Vergi beyannameleri, bildirgeler ve yasal mevzuat uyum süreçleri." },
  { icon: "🏛️", title: "Şirket Kuruluş Süreçleri", desc: "Şahıs, Limited ve Anonim şirket kuruluşları ile hukuki tescil işlemleri." },
  { icon: "💻", title: "E-Dönüşüm & Dijital", desc: "e-Fatura, e-Arşiv ve dijital muhasebe entegrasyonları." },
  { icon: "📊", title: "Mali Danışmanlık", desc: "Teşvik analizi, finansal tablo yorumlama ve stratejik danışmanlık." }
];
---

<Layout title="Hakkımda | Samet Can Tulum - SMMM" description="Hakkımda, vizyonum, misyonum ve çalışma prensiplerim hakkında bilgiler.">
  <main class="bg-slate-50 text-slate-800 min-h-screen">

    <!-- SABİT MENÜ -->
    <nav class="sticky top-0 bg-white/95 backdrop-blur-sm border-b border-slate-200 z-50 py-4 shadow-sm">
      <div class="max-w-5xl mx-auto px-4 flex flex-wrap gap-4 text-sm font-semibold text-slate-600 justify-center sm:justify-start">
        <a href="#hakkimda" class="hover:text-emerald-700">Hakkımda</a>
        <a href="#ilkeler" class="hover:text-emerald-700">İlkelerim</a>
        <a href="#vizyon" class="hover:text-emerald-700">Vizyon & Misyon</a>
        <a href="#sss" class="hover:text-emerald-700">SSS</a>
      </div>
    </nav>

    <!-- HEADER / HERO -->
    <section id="hakkimda" class="bg-white py-16">
      <div class="max-w-5xl mx-auto px-4">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 mb-6">Samet Can TULUM <br /> <span class="text-emerald-600">SMMM</span></h1>
        <p class="text-slate-600 text-lg leading-relaxed max-w-3xl text-justify mb-6">
          2011 yılında Pamukkale Üniversitesi İşletme Bölümü’nde başlayan akademik yolculuğumu; finans, yönetim ve ekonomi alanlarında aldığım güçlü altyapıyla tamamladım. Farklı sektörlerdeki saha tecrübelerim sayesinde mesleki yabancı dil yetkinliğimi ve pratik iletişim becerilerimi geliştirme fırsatı buldum. 2018 yılında adım attığım mali müşavirlik sektöründe, edindiğim tecrübe ve staj sürecimin ardından 2022 yılı itibarıyla Serbest Muhasebeci Mali Müşavir (SMMM) olarak bağımsız mesleki faaliyetlerime başladım.

        </p>



        <p class="text-slate-600 text-base sm:text-lg leading-relaxed max-w-3xl text-justify hyphens-auto" lang="tr">

          Benim için mali müşavirlik, yalnızca geçmiş döneme ait finansal verileri kayıt altına almak değil; işletmelerin geleceğe yönelik sürdürülebilir büyüme stratejilerini inşa etmektir. Bu doğrultuda hizmet anlayışımı veri odaklılık, şeffaflık ve teknolojiyle entegre çözümler temeli üzerine kurguluyorum.
        </p>
      </div>
    </section>

    <!-- İLKELERİM -->
    <section id="ilkeler" class="py-16 max-w-5xl mx-auto px-4 grid md:grid-cols-12 gap-12">
      <div class="md:col-span-7 space-y-6">
        <h2 class="text-2xl font-bold text-slate-900 border-b pb-3">Yaklaşımım ve Çalışma İlkelerim</h2>
        <p><b>Veri Odaklılık:</b> Finansal verileri stratejik büyüme kararlarına dönüştürüyorum.</p>
        <p><b>Uluslararası Destek:</b> İngilizce dil yetkinliğimle yabancı ortaklı firmalara özel süreç yönetimi sunuyorum.</p>
        <p><b>Dijital Entegrasyon:</b> Zaman ve kaynak verimliliği için dijital araçları merkezde tutuyorum.</p>
      </div>
      <div class="md:col-span-5 bg-white p-6 rounded-2xl border shadow-sm">
        <h3 class="font-bold mb-4">SMMM İlkeleri</h3>
        <ul class="space-y-3 text-sm text-slate-600">
          <li>🔒 Dürüstlük ve Gizlilik</li>
          <li>⚡ E-Dönüşüm Odaklılık</li>
          <li>📊 Proaktif Mevzuat Takibi</li>
        </ul>
      </div>
    </section>

    <!-- VİZYON & MİSYON -->
    <section id="vizyon" class="py-16 bg-slate-900 text-white">
      <div class="max-w-5xl mx-auto px-4 grid md:grid-cols-2 gap-12">
        <div>
          <h2 class="text-2xl font-bold mb-4">Vizyonumuz</h2>
          <p class="text-slate-300">Finansal süreçleri şeffaf ve erişilebilir kılarak, işletmelerin büyümesine rehberlik eden öncü mali müşavirlik ofisi olmak.</p>
        </div>
        <div>
          <h2 class="text-2xl font-bold mb-4">Misyonumuz</h2>
          <p class="text-slate-300">Mükelleflerimize sadece defter tutma değil, işletmelerini bir üst seviyeye taşıyacak stratejik mali danışmanlık sunmak.</p>
        </div>
      </div>
    </section>

    <!-- SSS (FAQ) -->
    <section id="sss" class="py-16 max-w-3xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-center mb-8">Sıkça Sorulan Sorular</h2>
      <div class="space-y-4">
        <details class="bg-white p-6 rounded-xl border border-slate-200">
          <summary class="font-bold cursor-pointer">Mali müşavirlik hizmeti ne tür kolaylıklar sağlar?</summary>
          <p class="mt-4 text-slate-600">İşletmenizin yasal yükümlülüklerini hatasız yöneterek, vergi cezalarından korunmanızı ve teşviklerden yararlanmanızı sağlar.</p>
        </details>
        <details class="bg-white p-6 rounded-xl border border-slate-200">
          <summary class="font-bold cursor-pointer">Süreçler dijital ortamda mı yürütülüyor?</summary>
          <p class="mt-4 text-slate-600">Evet, e-dönüşüm araçları ile tüm süreçlerinizi dijital, hızlı ve şeffaf bir şekilde yönetiyoruz.</p>
        </details>
      </div>
    </section>

  </main>
</Layout>