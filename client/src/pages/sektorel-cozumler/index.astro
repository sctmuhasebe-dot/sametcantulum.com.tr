---
export const prerender = true; // 🚀 Statik build edilerek sunucu yükü azaltıldı ve TTFB optimize edildi
import Layout from '../../layouts/Layout.astro';

const sektorler = [
  {
    slug: "e-ticaret-ve-pazaryerleri",
    title: "E-Ticaret ve Pazaryerleri",
    category: "Dijital Ticaret",
    badgeColor: "bg-blue-50 text-blue-700 border-blue-200 hover:border-blue-500",
    icon: "🛒",
    desc: "Trendyol, Hepsiburada, Amazon ve yurt dışı pazaryerlerindeki e-fatura/e-arşiv süreçleri, entegrasyon kayıtları ve KDV mevzuatı.",
    features: ["Pazaryeri Muhasebe Kayıtları", "Mikro İhracat KDV Listeleri Hazırlığı", "ETGB ve Gümrük Evrak Takibi"]
  },
  {
    slug: "yazilim-ve-teknoloji",
    title: "Yazılım ve Teknoloji Şirketleri",
    category: "Teknoloji & AR-GE",
    badgeColor: "bg-indigo-50 text-indigo-700 border-indigo-200 hover:border-indigo-500",
    icon: "💻",
    desc: "Teknokent/Teknoloji Geliştirme Bölgesi istisnaları, yurt dışı yazılım kazanç indirimi ve AR-GE mevzuatı takibi.",
    features: ["Kurumlar/Gelir Vergisi İstisna Takibi", "Teknokent Beyanname ve Muafiyetleri", "Yurt Dışı Yazılım Faturalandırması"]
  },
  {
    slug: "insaat-ve-gayrimenkul",
    title: "İnşaat ve Gayrimenkul",
    category: "Reel Sektör",
    badgeColor: "bg-amber-50 text-amber-700 border-amber-200 hover:border-amber-500",
    icon: "🏗️",
    desc: "Yıllara sari inşaat onarım işleri, hakediş kayıtları, KDV iade dosya hazırlığı ve kat karşılığı arsa maliyet muhasebesi.",
    features: ["İndirimli Oran KDV Dosya Hazırlığı", "Yıllara Sari İnşaat Stopaj Takibi", "Arsa Sahibi / Yüklenici Maliyet Takibi"]
  },
  {
    slug: "turizm-ve-otelcilik",
    title: "Turizm ve Konaklama",
    category: "Hizmet Sektörü",
    badgeColor: "bg-teal-50 text-teal-700 border-teal-200 hover:border-teal-500",
    icon: "🏖️",
    desc: "Konaklama vergisi beyanları, TGA (Turizm Geliştirme Ajansı) payı hesaplamaları ve sektörel teşvik mevzuatı bilgilendirmesi.",
    features: ["Konaklama Vergisi Beyannameleri", "TGA Payı Takibi ve Hesaplamaları", "Acenta / Otel Cari Mutabakatları"]
  },
  {
    
    title: "Tarım ve Hayvancılık İşletmeleri",
    category: "Üretim & Tarım",
    badgeColor: "bg-emerald-50 text-emerald-700 border-emerald-200 hover:border-emerald-500",
    icon: "🌱",
    desc: "Müstahsil makbuzu düzenlemeleri, tarımsal destekleme primleri kayıtları, sera/özel ürün maliyetleri ve Kooperatif vergilendirmesi.",
    features: ["Müstahsil Makbuzu & Stopaj Takibi", "Tarımsal Hibe ve Destek Kayıtları", "Sera ve Özel Ürün Maliyet Muhasebesi"]
  },
  {
    
    title: "Sağlık Sektörü",
    category: "Sağlık",
    badgeColor: "bg-rose-50 text-rose-700 border-rose-200 hover:border-rose-500",
    icon: "⚕️",
    desc: "Sağlık turizmi vergi istisnaları, doktor ve klinik işletme modelleri, serbest meslek kazanç tespiti ve SGK mevzuatı.",
    features: ["Sağlık Turizmi Vergi İstisnası Takibi", "Klinik & Muayenehane Şirketleşmesi", "POS ve E-SMM Süreç Yönetimi"]
  }
];
---

<Layout 
  title="Sektörel Muhasebe ve Vergi Mevzuatı | Samet Can Tulum"
  description="İşletmenizin faaliyet gösterdiği sektöre özel mevzuat, vergi uygulamaları ve muhasebe süreçlerimizi inceleyin."
>
  <main class="bg-slate-50 min-h-screen py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- BAŞLIK ALANI -->
      <div class="bg-white rounded-2xl border border-slate-200 p-8 lg:p-12 shadow-sm text-center max-w-4xl mx-auto">
        <h1 class="text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
          Sektörel Muhasebe ve <span class="text-blue-600">Mevzuat Çözümleri</span>
        </h1>
        <p class="text-slate-600 text-base lg:text-lg mt-4 leading-relaxed">
          Her sektörün mali dinamikleri, teşvikleri ve mevzuat yükümlülükleri farklılık gösterir. İş alanınıza özel mevzuat takibiyle vergi uyum süreçlerinizi yönetiyor ve kanuni haklarınızdan yararlanmanızı sağlıyoruz.
        </p>
      </div>

      <!-- SEKTÖR KARTLARI GRID -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sektorler.map((item) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm hover:shadow-md transition-all flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-3xl" aria-hidden="true">{item.icon}</span>
                <span class={`text-xs font-bold px-3 py-1 rounded-full border ${item.badgeColor}`}>
                  {item.category}
                </span>
              </div>
              <h2 class="text-xl font-bold text-slate-900">{item.title}</h2>
              <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
              
              <hr class="border-slate-100 my-4" />
              
              <ul class="space-y-2">
                {item.features.map((feat) => (
                  <li class="text-xs text-slate-700 flex items-center gap-2 font-medium">
                    <span class="text-emerald-500 font-bold" aria-hidden="true">✓</span> {feat}
                  </li>
                ))}
              </ul>
            </div>

            <a 
              href={`/sektorel-cozumler/${item.slug}`} 
              class="inline-flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold transition-all"
            >
              Detaylı Bilgi
              <span aria-hidden="true">→</span>
            </a>
          </div>
        ))}
      </div>

      <!-- ÖZEL DANIŞMANLIK BANT -->
      <div class="bg-gradient-to-r from-slate-900 to-slate-800 text-white rounded-2xl p-8 lg:p-12 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2">
          <h2 class="text-2xl font-bold">Sektörünüz listede yer almıyor mu?</h2>
          <p class="text-slate-300 text-sm max-w-2xl">
            Farklı bir alanda faaliyet gösteriyorsanız, işletmenizin mevzuat ve muhasebe süreçleri hakkında bilgi almak için bizimle iletişime geçebilirsiniz.
          </p>
        </div>
        <a href="/iletisim" class="px-6 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold transition-all shadow-md shrink-0 text-sm">
          İletişime Geçin
        </a>
      </div>

    </div>
  </main>
</Layout>