---
export const prerender = true; // 🚀 Statik build edilerek sunucu yükü kaldırıldı ve TTFB hızlandırıldı
import Layout from '../../layouts/Layout.astro';

const hizmetDetaylari = [
  { 
    title: `Genel Muhasebe ve Defter Tutma`, 
    desc: `Vergi Usul Kanunu ve Türk Ticaret Kanunu uyarınca yasal defterlerin elektronik ortamda (e-Defter) usulüne uygun tutulması.` 
  },
  { 
    title: `Beyanname ve Bildirimler`, 
    desc: `KDV, Muhtasar, Kurumlar/Gelir Vergisi ve Geçici Vergi beyannamelerinin zamanında hazırlanıp onaylanması.` 
  },
  { 
    title: `Bordrolama ve SGK İşlemleri`, 
    desc: `Personel işe giriş/çıkış süreçleri, aylık prim ve hizmet belgelerinin düzenlenmesi ve SGK mevzuatı takibi.` 
  },
  { 
    title: `E-Fatura ve E-Dönüşüm`, 
    desc: `e-Fatura, e-Arşiv, e-SMM ve e-İrsaliye sistemlerine entegrasyon ve teknik süreç danışmanlığı.` 
  }
];
---

<Layout 
  title="Antalya Mali Müşavirlik ve Muhasebe Hizmetleri | Samet Can Tulum" 
  description="Antalya merkezli ofisimizde şirketlerin vergi beyannameleri, defter tutma ve yasal mevzuat uyum süreçleri."
>
  <main class="bg-slate-50 min-h-screen py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- BAŞLIK ALANI -->
      <div class="bg-white rounded-2xl border border-slate-200 p-8 lg:p-12 shadow-sm">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-semibold mb-4">
          Hizmet Kapsamı
        </div>
        <h1 class="text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
          Mali Müşavirlik ve <span class="text-blue-900">Muhasebe Hizmetleri</span>
        </h1>
        <p class="text-slate-600 text-base lg:text-lg mt-4 max-w-3xl leading-relaxed">
          İşletmelerin finansal verileri yasal standartlara uygun olarak kayıt altına alınmakta; vergi ve SGK yükümlülükleri mevzuat çerçevesinde takip edilmektedir.
        </p>
      </div>

      <!-- İÇERİK GRID -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {hizmetDetaylari.map((item) => (
          <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm hover:border-blue-900 transition-all space-y-3">
            <div class="w-10 h-10 rounded-xl bg-slate-100 text-blue-900 flex items-center justify-center font-bold text-lg" aria-hidden="true">
              ✓
            </div>
            <h2 class="font-bold text-lg text-slate-900">{item.title}</h2>
            <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <!-- BİLGİ & İLETİŞİM ÇAĞRISI -->
      <div class="bg-slate-900 text-white rounded-2xl p-8 lg:p-12 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <h2 class="text-2xl font-bold">Mevzuat ve Muhasebe Süreçleri</h2>
          <p class="text-slate-300 text-sm mt-2">İşletmenizin mali süreçleri ve yasal yükümlülükleri hakkında bilgi almak için iletişime geçebilirsiniz.</p>
        </div>
        <a href="/iletisim" class="px-6 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold transition-all shadow-md shrink-0 text-sm">
          İletişime Geçin
        </a>
      </div>

    </div>
  </main>
</Layout>