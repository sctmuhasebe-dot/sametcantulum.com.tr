---
// client/src/pages/hizmetler/index.astro
export const prerender = true;
import Layout from '../../layouts/Layout.astro';

// SMMM Reklam Yasağı and Etik Kurallara Uygun Hizmet Grupları
const hizmetKategorileri = [
  {
    kategori: "Genel Muhasebe & Vergi Süreçleri",
    aciklama: "Yasal defter tutma, beyanname hazırlığı ve vergi mevzuatı uyum süreçleri.",
    hizmetler: [
      {
        icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
        title: "Defter Tutma ve Kayıt Yönetimi",
        desc: "3568 Sayılı Kanun kapsamında yasal defterlerin Tekdüzen Hesap Planı ve VUK hükümlerine göre tutulması ve işlenmesi."
      },
      {
        icon: "M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z",
        title: "Beyanname ve Bildirim Hizmetleri",
        desc: "KDV, Muhtasar, Geçici Vergi, Gelir ve Kurumlar Vergisi beyannamelerinin zamanında tanzim edilerek vergi dairesine onaya sunulması."
      },
      {
        icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
        title: "Mali Tablolar Analizi ve Raporlama",
        desc: "Bilanço, Gelir Tablosu ve dipnotların hazırlanarak işletmenin finansal röntgeninin çekilmesi ve yönetsel raporlar sunulması."
      }
    ]
  },
  {
    kategori: "E-Dönüşüm & Dijital Süreçler",
    aciklama: "Gelir İdaresi Başkanlığı (GİB) standartlarında dijital entegrasyon çözümleri.",
    hizmetler: [
      {
        icon: "M13 10V3L4 14h7v7l9-11h-7z",
        title: "E-Fatura & E-Arşiv Geçiş Uyum Danışmanlığı",
        desc: "E-Fatura, e-Arşiv, e-İrsaliye ve e-SMM sistemlerinin kuruluş altyapılarının yapılandırılması ve teknik rehberlik."
      },
      {
        icon: "M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z",
        title: "E-Defter Oluşturma ve Berat Yükleme",
        desc: "Yasal süreler dahilinde e-Defterlerin hazırlanması, zaman damgasıyla imzalanması ve GİB sistemine berat entegrasyonu."
      }
    ]
  },
  {
    kategori: "Şirket Kuruluşu & İş Kurma Süreçleri",
    aciklama: "Girişimciler ve işletmeler için kuruluş aşamasından tescil sürecine rehberlik.",
    hizmetler: [
      {
        icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0a1 1 0 011-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6",
        title: "Şahıs, Limited ve Anonim Şirket Kuruluşu",
        desc: "Şirket ana sözleşmesinin hazırlanması, MERSİS işlemleri, ticaret sicil tescili ve vergi dairesi açılış süreçlerinin takibi."
      },
      {
        icon: "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15",
        title: "Adres, Unvan ve Sermaye Değişiklikleri",
        desc: "Şirket içi karar defterlerinin yazılması, tescil ilan işlemleri, şube açılış/kapanış ve adres değişiklik prosedürleri."
      }
    ]
  },
  {
    kategori: "SGK & İş Hukuku Uyum Hizmetleri",
    aciklama: "İstihdam, bordrolama ve sosyal güvenlik mevzuatı süreçleri.",
    hizmetler: [
      {
        icon: "M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
        title: "Bordrolama ve İşe Giriş-Çıkış İşlemleri",
        desc: "Personel özlük dosyalarının kontrolü, işe giriş/çıkış bildirgeleri ve aylık prim/hizmet belgelerinin SGK sistemine iletilmesi."
      },
      {
        icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
        title: "SGK Teşvik Danışmanlığı",
        desc: "Cari dönemde geçerli olan SGK prim teşvik ve desteklerinin analiz edilerek işletme maliyetlerine uygun şekilde uygulanması."
      }
    ]
  }
];
---

<Layout 
  title="Mesleki Faaliyetlerimiz | SMMM Samet Can Tulum"
  description="3568 Sayılı Kanun kapsamındaki muhasebe, vergi, e-dönüşüm, şirket kuruluşu ve SGK danışmanlığı süreçlerimize dair mesleki bilgilendirme sayfası."
>
  <main class="bg-slate-50 text-slate-800 min-h-screen">
    
    <!-- 1. HERO / BAŞLIK ALANI -->
    <section class="bg-white border-b border-slate-200/80 py-12 lg:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/60 text-emerald-700 text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            3568 Sayılı Kanun Kapsamındaki Hizmetler
          </div>
          <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
            Mali Müşavirlik & <br />
            <span class="text-emerald-600">Mesleki Danışmanlık</span> Hizmetleri
          </h1>
          <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
            3568 Sayılı Serbest Muhasebeci Mali Müşavirlik Kanunu ve ilgili yasal mevzuat hükümleri çerçevesinde; işletmelerin muhasebe, vergi, e-dönüşüm ve SGK süreçlerinde şeffaf ve mevzuata uyumlu mesleki hizmet sunulmaktadır.
          </p>
        </div>
      </div>
    </section>

    <!-- 2. HİZMET KATEGORİLERİ VE KARTLAR -->
    <section class="py-12 lg:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      {hizmetKategorileri.map((grup) => (
        <div class="space-y-6">
          
          <!-- Kategori Başlığı -->
          <div class="border-b border-slate-200/80 pb-3">
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
              {grup.kategori}
            </h2>
            <p class="text-slate-500 text-xs sm:text-sm mt-1">
              {grup.aciklama}
            </p>
          </div>

          <!-- Kategoriye Ait Kartlar Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {grup.hizmetler.map((item) => (
              <div class="bg-white rounded-2xl border border-slate-200/80 p-6 hover:border-emerald-500/40 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 flex flex-col justify-between group">
                <div class="space-y-4">
                  <!-- Vector Icon -->
                  <div class="w-12 h-12 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-600 group-hover:border-emerald-100 transition-colors shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
                      <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                    </svg>
                  </div>

                  <h3 class="text-base font-bold text-slate-900 group-hover:text-emerald-600 transition-colors">
                    {item.title}
                  </h3>

                  <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                    {item.desc}
                  </p>
                </div>

                <div class="pt-4 mt-6 border-t border-slate-100 flex items-center justify-between text-[11px]">
                  <span class="font-medium text-slate-400">
                    Mevzuat Standartları
                  </span>
                  <span class="font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">
                    3568 S.K. Uyumlu
                  </span>
                </div>
              </div>
            ))}
          </div>

        </div>
      ))}
    </section>

    <!-- 3. KURUMSAL İLETİŞİM BANNER -->
    <section class="py-12 bg-white border-t border-slate-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-slate-900 rounded-2xl p-8 sm:p-10 text-white flex flex-col lg:flex-row items-center justify-between gap-6 shadow-xl relative overflow-hidden">
          
          <div class="space-y-2 text-center lg:text-left z-10">
            <h3 class="text-xl sm:text-2xl font-bold">
              Mali Süreçleriniz İle İlgili Bilgi Alın
            </h3>
            <p class="text-slate-300 text-xs sm:text-sm max-w-2xl leading-relaxed">
              Şirket kuruluşu, vergi planlaması veya e-dönüşüm süreçlerinizle ilgili resmi prosedürler ve mevzuat detayları için iletişim kanallarımız üzerinden büromuza ulaşabilirsiniz.
            </p>
          </div>
          
          <a 
            href="/iletisim" 
            class="z-10 px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold transition-all text-xs sm:text-sm shrink-0 shadow-md hover:shadow-emerald-600/20"
          >
            İletişime Geç →
          </a>
        </div>

        <!-- 4. ETİK & REKLAM YASAĞI BİLGİLENDİRME DİPNOTU (YASAL UYARI) -->
        <div class="mt-8 pt-6 border-t border-slate-100 text-center">
          <p class="text-[11px] text-slate-400 leading-relaxed max-w-4xl mx-auto">
            <strong>Yasal Bilgilendirme:</strong> Bu sitede yer alan içerikler, 3568 Sayılı Serbest Muhasebeci Mali Müşavirlik Kanunu ile SMMM Meslek Mensuplarının Haksız Rekabet ve Reklam Yasağı Yönetmeliği hükümlerine uygun olarak, yalnızca bilgilendirme amacıyla hazırlanmıştır. Haksız rekabet and reklam amacı taşımamaktadır.
          </p>
        </div>

      </div>
    </section>

  </main>
</Layout>