---
import Layout from '../layouts/Layout.astro';
---

<Layout title="KVKK Açık Rıza Metni | Samet Can Tulum - SMMM">
  <main class="max-w-4xl mx-auto px-4 py-12 text-slate-800">
    <h1 class="text-3xl font-bold mb-4 text-slate-900 border-b pb-4 text-center">
      KİŞİSEL VERİLERİN İŞLENMESİNE İLİŞKİN AÇIK RIZA METNİ
    </h1>
    <p class="text-sm text-slate-500 mb-8 text-right">ID: <span class="font-mono">ONAY-FORMU-{Date.now()}</span></p>

    <div class="space-y-6 text-sm md:text-base leading-relaxed text-justify">
      
      <div class="bg-emerald-50 border-l-4 border-emerald-600 p-4 rounded-r-lg mb-6 text-justify">
        <p class="text-emerald-900 font-medium">
          İnternet sitemizde yer alan Aydınlatma Metni'ni okudum, anladım ve 6698 sayılı Kişisel Verilerin Korunması Kanunu kapsamında aşağıdaki hususlara özgür irademle onay veriyorum.
        </p>
      </div>

      <!-- Form Alanı Başlangıcı -->
      <form class="space-y-8 bg-white p-6 md:p-8 rounded-xl shadow-sm border border-slate-200 text-left" id="kvkkConsentForm">
        
        <!-- A. Yurt İçi Onay -->
        <div class="space-y-3">
          <h2 class="text-lg font-semibold text-slate-900">A. Yurt İçinde Veri İşlenmesi</h2>
          <p class="text-slate-600 text-sm text-justify">
            Paylaşmış olduğum özel nitelikli kategorideki verilerimin, Veri Sorumlusu sıfatıyla <strong>SAMET CAN TULUM SERBEST MUHASEBECİ MALİ MÜŞAVİR BÜROSU</strong> tarafından işlenmesi için:
          </p>
          <label class="flex items-start space-x-3 p-3 rounded-lg border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
            <input type="checkbox" name="yurtIciOnay" required class="mt-1 h-5 w-5 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500">
            <span class="text-slate-800 font-medium">Açık rızamı veriyorum. <span class="text-red-500">*</span></span>
          </label>
        </div>

        <!-- B. Yurt Dışı Onay -->
        <div class="space-y-3 pt-4 border-t border-slate-100">
          <h2 class="text-lg font-semibold text-slate-900">B. Yurt Dışına Veri Aktarımı</h2>
          <p class="text-slate-600 text-sm text-justify">
            Özel nitelikli kategorideki veriler de dahil olmak üzere kişisel verilerimin <strong>SAMET CAN TULUM SERBEST MUHASEBECİ MALİ MÜŞAVİR BÜROSU</strong> tarafından Aydınlatma Metninde sayılan ve bilişim, iletişim ve belge üretimi/saklanması gibi veri aktarım amaçları ile sınırlı olmak kaydıyla; bulut tabanlı platformlar, e-posta altyapıları ve iletişim uygulamaları (WhatsApp vb.) gibi yurt dışında yerleşik sunucularda barındırılan sistemler üzerinden aktarılmasına:
          </p>
          <label class="flex items-start space-x-3 p-3 rounded-lg border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
            <input type="checkbox" name="yurtDisiOnay" required class="mt-1 h-5 w-5 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500">
            <span class="text-slate-800 font-medium">Açık rızamı veriyorum. <span class="text-red-500">*</span></span>
          </label>
        </div>

        <!-- Başvuru Bilgilendirme Notu -->
        <div class="p-4 bg-slate-50 rounded-lg border border-slate-200 text-xs text-slate-600 space-y-2">
          <p class="font-semibold text-slate-700">Bilgilendirme:</p>
          <p>
            6698 sayılı Kanun kapsamındaki haklarınıza ve taleplerinize ilişkin başvurularınızı, doğrudan web sitemizde yer alan <a href="/iletisim" target="_blank" class="text-emerald-600 font-semibold underline hover:text-emerald-700">İletişim Sayfası</a> üzerinden bize iletebilirsiniz.
          </p>
        </div>

        <!-- Kimlik ve Onay Bilgileri -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-4 border-t border-slate-100">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Adı Soyadı / Unvan <span class="text-red-500">*</span></label>
            <input type="text" name="adSoyad" required placeholder="Adınız Soyadınız" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">E-Posta Adresi <span class="text-red-500">*</span></label>
            <input type="email" name="eposta" required placeholder="ornek@mail.com" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 text-sm">
          </div>
        </div>

        <div class="pt-4 flex items-center justify-between">
          <span class="text-xs text-slate-500">Tarih: <strong id="currentDate"></strong></span>
          <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-6 py-2.5 rounded-lg transition-colors text-sm shadow-md">
            Onayı Gönder
          </button>
        </div>

      </form>
    </div>
  </main>
</Layout>

<script>
  const dateSpan = document.getElementById('currentDate');
  if (dateSpan) {
    const today = new Date();
    dateSpan.textContent = today.toLocaleDateString('tr-TR');
  }

  const form = document.getElementById('kvkkConsentForm');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Açık rıza metni onayınız başarıyla kaydedilmiştir.');
      form.reset();
    });
  }
</script>