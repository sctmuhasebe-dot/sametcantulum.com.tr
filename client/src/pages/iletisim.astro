---
// client/src/pages/iletisim.astro
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// Varsayılan İletişim Bilgileri (Fallback)
let siteSettings = {
  phone: '+90 (542) 784 62 60',
  email: 'info@sametcantulum.com.tr',
  address: 'Antalya, Türkiye',
  map_embed_code: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3190.257203074035!2d30.696862976273536!3d36.90811436160822!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6d8183bc07d1ca57%3A0x528579bedf43092d!2sMali%20M%C3%üşavir%20Samet%20Can%20TULUM!5e0!3m2!1str!2str!4v1785243946408!5m2!1str!2str'
};

// Supabase üzerinden ayarları çekmeyi deniyoruz
try {
  const { data, error } = await supabase.from('settings').select('*').single();
  if (!error && data) {
    siteSettings = { ...siteSettings, ...data };
  }
} catch (err) {
  // Tablo yoksa veya hata olursa varsayılan değerlerle devam eder
}
---

<Layout title="İletişim & Konum | Samet Can Tulum - SMMM">
  <main class="max-w-6xl mx-auto px-4 py-12">
    
    <!-- Başlık / Hero -->
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <span class="px-3 py-1 bg-emerald-50 text-emerald-700 font-bold text-xs uppercase tracking-wider rounded-lg border border-emerald-100 inline-block mb-3">
        Bize Ulaşın
      </span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900">İletişim & Konum</h1>
      <p class="text-slate-600 mt-2">Mali danışmanlık, vergi süreçleri ve randevu talepleriniz için doğrudan iletişime geçebilirsiniz.</p>
    </div>

    <!-- İletişim Kartları ve Form Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
      
      <!-- Sol Kolon: Adres / Telefon / E-posta Kartları -->
      <div class="space-y-6">
        
        <!-- Telefon -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0">
            📞
          </div>
          <div>
            <h3 class="font-bold text-slate-900 text-sm">Telefon</h3>
            <p class="text-xs text-slate-500 mb-1">Mesai saatleri içinde ulaşabilirsiniz.</p>
            <a href={`tel:${siteSettings.phone.replace(/[^+\d]/g, '')}`} class="text-emerald-600 font-semibold text-sm hover:underline">
              {siteSettings.phone}
            </a>
          </div>
        </div>

        <!-- E-posta -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0">
            ✉️
          </div>
          <div>
            <h3 class="font-bold text-slate-900 text-sm">E-Posta</h3>
            <p class="text-xs text-slate-500 mb-1">Sorularınız için e-posta gönderebilirsiniz.</p>
            <a href={`mailto:${siteSettings.email}`} class="text-emerald-600 font-semibold text-sm hover:underline">
              {siteSettings.email}
            </a>
          </div>
        </div>

        <!-- Ofis Adresi -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0">
            📍
          </div>
          <div>
            <h3 class="font-bold text-slate-900 text-sm">Ofis Adresi</h3>
            <p class="text-slate-600 text-sm mt-1">{siteSettings.address}</p>
          </div>
        </div>

      </div>

      <!-- Sağ Kolon: İletişim Formu -->
      <div class="lg:col-span-2 bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 mb-6">Mesaj Gönderin</h2>

        <form id="contact-form" class="space-y-4" novalidate>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="cf-name" class="block text-xs font-semibold text-slate-700 mb-1">Adınız Soyadınız <span class="text-red-500">*</span></label>
              <input id="cf-name" name="name" type="text" required placeholder="Örn. Ahmet Yılmaz" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 text-sm" />
            </div>
            <div>
              <label for="cf-email" class="block text-xs font-semibold text-slate-700 mb-1">E-Posta Adresiniz <span class="text-red-500">*</span></label>
              <input id="cf-email" name="email" type="email" required placeholder="ahmet@example.com" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 text-sm" />
            </div>
          </div>

          <!-- Cep Telefonu Alanı -->
          <div>
            <label for="cf-phone" class="block text-xs font-semibold text-slate-700 mb-1">Cep Telefonu Numaranız <span class="text-red-500">*</span></label>
            <input id="cf-phone" name="phone" type="tel" required placeholder="05XX XXX XX XX" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 text-sm" />
          </div>

          <div>
            <label for="cf-subject" class="block text-xs font-semibold text-slate-700 mb-1">Konu <span class="text-red-500">*</span></label>
            <input id="cf-subject" name="subject" type="text" required placeholder="Vergi Danışmanlığı Hakkında" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 text-sm" />
          </div>

          <div>
            <label for="cf-message" class="block text-xs font-semibold text-slate-700 mb-1">Mesajınız <span class="text-red-500">*</span></label>
            <textarea id="cf-message" name="message" required rows="4" placeholder="Mesajınızı detaylıca yazabilirsiniz..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 text-sm"></textarea>
          </div>

          <!-- Yasal Onay Kutuları -->
          <div class="space-y-3 pt-2">
            <div class="flex items-start gap-3">
              <input id="cf-kvkk" name="kvkk" type="checkbox" required class="mt-0.5 w-4 h-4 text-emerald-600 border-slate-300 rounded focus:ring-emerald-500 cursor-pointer" />
              <label for="cf-kvkk" class="text-xs text-slate-600 leading-relaxed select-none">
                <a href="/kvkk-aydinlatma-metni" target="_blank" class="text-emerald-600 font-semibold underline hover:text-emerald-700">KVKK Aydınlatma Metni</a>’ni okudum. Kişisel verilerimin işlenmesini onaylıyorum. <span class="text-red-500">*</span>
              </label>
            </div>

            <div class="flex items-start gap-3">
              <input id="cf-akis" name="akis" type="checkbox" required class="mt-0.5 w-4 h-4 text-emerald-600 border-slate-300 rounded focus:ring-emerald-500 cursor-pointer" />
              <label for="cf-akis" class="text-xs text-slate-600 leading-relaxed select-none">
                <a href="/acik-riza-metni" target="_blank" class="text-emerald-600 font-semibold underline hover:text-emerald-700">Açık Rıza Metni</a>’ni okudum ve onaylıyorum. <span class="text-red-500">*</span>
              </label>
            </div>

            <div class="flex items-start gap-3">
              <input id="cf-taahhutname" name="taahhutname" type="checkbox" required class="mt-0.5 w-4 h-4 text-emerald-600 border-slate-300 rounded focus:ring-emerald-500 cursor-pointer" />
              <label for="cf-taahhutname" class="text-xs text-slate-600 leading-relaxed select-none">
                <a href="/kisisel-verilerin-aktarimi-taahhutname" target="_blank" class="text-emerald-600 font-semibold underline hover:text-emerald-700">Kişisel Verilerin Aktarımına İlişkin Taahhütname</a>’yi okudum, kabul ediyorum. <span class="text-red-500">*</span>
              </label>
            </div>
          </div>

          <button type="submit" id="cf-submit" class="w-full md:w-auto px-6 py-3 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-sm rounded-xl transition-colors shadow-sm disabled:opacity-60 disabled:cursor-not-allowed">
            Mesajı Gönder
          </button>

          <p id="cf-feedback" class="text-sm hidden" role="status" aria-live="polite"></p>
        </form>
      </div>

    </div>

    <!-- Google Harita Alanı -->
    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <h3 class="font-bold text-slate-900 text-sm mb-3 px-2">Harita / Haritadaki Konumumuz</h3>
      <div class="w-full h-[400px] rounded-xl overflow-hidden bg-slate-100">
        <iframe src={siteSettings.map_embed_code} width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>

  </main>

  <!-- İstemci Scripti -->
  <script>
    import { supabase } from '../lib/supabase';

    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement;
    const feedback = document.getElementById('cf-feedback');
    const kvkkCheckbox = document.getElementById('cf-kvkk') as HTMLInputElement;
    const akisCheckbox = document.getElementById('cf-akis') as HTMLInputElement;
    const taahhutnameCheckbox = document.getElementById('cf-taahhutname') as HTMLInputElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!feedback || !submitBtn) return;

      // Onay kutusu kontrolleri
      if (kvkkCheckbox && !kvkkCheckbox.checked) {
        feedback.textContent = 'Lütfen devam etmeden önce KVKK Aydınlatma Metni onay kutusunu işaretleyin.';
        feedback.className = 'text-sm text-red-700 bg-red-50 border border-red-200 rounded-xl px-4 py-3';
        feedback.classList.remove('hidden');
        return;
      }
      if (akisCheckbox && !akisCheckbox.checked) {
        feedback.textContent = 'Lütfen devam etmeden önce Açık Rıza Metni onay kutusunu işaretleyin.';
        feedback.className = 'text-sm text-red-700 bg-red-50 border border-red-200 rounded-xl px-4 py-3';
        feedback.classList.remove('hidden');
        return;
      }
      if (taahhutnameCheckbox && !taahhutnameCheckbox.checked) {
        feedback.textContent = 'Lütfen devam etmeden önce Kişisel Verilerin Aktarımına İlişkin Taahhütname onay kutusunu işaretleyin.';
        feedback.className = 'text-sm text-red-700 bg-red-50 border border-red-200 rounded-xl px-4 py-3';
        feedback.classList.remove('hidden');
        return;
      }

      const formData = new FormData(form);
      const name = formData.get('name');
      const email = formData.get('email');
      const phone = formData.get('phone');
      const subject = formData.get('subject');
      const message = formData.get('message');

      submitBtn.disabled = true;
      submitBtn.textContent = 'Gönderiliyor...';
      feedback.classList.add('hidden');

      try {
        const { error } = await supabase
          .from('messages')
          .insert([
            { 
              name, 
              email, 
              phone, 
              subject, 
              message,
              kvkk: true,
              akis: true,
              taahhutname: true
            }
          ]);

        if (error) throw error;

        feedback.textContent = 'Mesajınız başarıyla gönderildi ve tarafınıza iletildi. Teşekkür ederiz!';
        feedback.className = 'text-sm text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-xl px-4 py-3';
        form.reset();
      } catch (err: any) {
        console.error('Form Gönderim Hatası:', err);
        feedback.textContent = `Hata: ${err.message || 'Mesaj gönderilemedi, lütfen tekrar deneyin.'}`;
        feedback.className = 'text-sm text-red-700 bg-red-50 border border-red-200 rounded-xl px-4 py-3';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Mesajı Gönder';
        feedback.classList.remove('hidden');
      }
    });
  </script>
</Layout>