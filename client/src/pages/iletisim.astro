---
// client/src/pages/iletisim.astro
export const prerender = false;

import Layout from '../layouts/Layout.astro';
---

<Layout title="İletişim | Samet Can Tulum - SMMM">
  <main class="bg-slate-50 min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto space-y-10">
      
      <!-- Başlık Alanı -->
      <div class="bg-white rounded-2xl border border-slate-200 p-8 lg:p-12 shadow-sm text-center max-w-3xl mx-auto space-y-3">
        <span class="inline-block px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold rounded-full uppercase tracking-wider">
          İletişim
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Bizimle İletişime Geçin
        </h1>
        <p class="text-slate-600 text-sm sm:text-base">
          Mali müşavirlik hizmetleri, danışmanlık veya sorularınız için formu doldurabilir ya da doğrudan iletişim kanallarımızdan ulaşabilirsiniz.
        </p>
      </div>

      <!-- Ana İçerik Grid Yapısı (Sol Bilgiler, Sağ Form) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Sol Taraf: İletişim Bilgileri Kartı -->
        <div class="lg:col-span-1 space-y-6">
          <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-6">
            <h2 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-4">
              İletişim Bilgileri
            </h2>

            <div class="space-y-5 text-sm text-slate-600">
              <!-- Adres -->
              <div class="flex items-start gap-3.5">
                <div class="p-2.5 bg-emerald-50 text-emerald-600 rounded-xl border border-emerald-100 shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <p class="font-bold text-slate-900">Ofis Adresi</p>
                  <p class="mt-0.5 leading-relaxed text-xs sm:text-sm">Antalya / Türkiye</p>
                </div>
              </div>

              <!-- Telefon -->
              <div class="flex items-start gap-3.5">
                <div class="p-2.5 bg-emerald-50 text-emerald-600 rounded-xl border border-emerald-100 shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <p class="font-bold text-slate-900">Telefon</p>
                  <a href="tel:+900000000000" class="mt-0.5 block hover:text-emerald-600 transition-colors text-xs sm:text-sm">
                    +90 (---) --- -- --
                  </a>
                </div>
              </div>

              <!-- E-Posta -->
              <div class="flex items-start gap-3.5">
                <div class="p-2.5 bg-emerald-50 text-emerald-600 rounded-xl border border-emerald-100 shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="font-bold text-slate-900">E-Posta</p>
                  <a href="mailto:info@sametcantulum.com.tr" class="mt-0.5 block hover:text-emerald-600 transition-colors text-xs sm:text-sm break-all">
                    info@sametcantulum.com.tr
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Sağ Taraf: İletişim Formu -->
        <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">
          <form id="contactForm" class="space-y-6">
            <div id="formAlert" class="hidden p-4 rounded-xl text-sm"></div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-xs font-medium text-slate-600 mb-1">Adınız Soyadınız *</label>
                <input type="text" id="name" required placeholder="Ad Soyad" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 text-slate-900" />
              </div>
              <div>
                <label for="phone" class="block text-xs font-medium text-slate-600 mb-1">Telefon Numarası *</label>
                <input type="tel" id="phone" required placeholder="05XX XXX XX XX" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 text-slate-900" />
              </div>
            </div>

            <div>
              <label for="email" class="block text-xs font-medium text-slate-600 mb-1">E-Posta Adresi *</label>
              <input type="email" id="email" required placeholder="ornek@domain.com" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 text-slate-900" />
            </div>

            <div>
              <label for="subject" class="block text-xs font-medium text-slate-600 mb-1">Konu *</label>
              <input type="text" id="subject" required placeholder="Mesajınızın konusu" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 text-slate-900" />
            </div>

            <div>
              <label for="message" class="block text-xs font-medium text-slate-600 mb-1">Mesajınız *</label>
              <textarea id="message" rows="5" required placeholder="Mesajınızı buraya yazın..." class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 text-slate-900"></textarea>
            </div>

            <!-- Yasal Metinler ve Onay Kutuları -->
            <div class="space-y-3 pt-2 text-xs text-slate-600">
              <label class="flex items-start gap-2.5 cursor-pointer">
                <input type="checkbox" id="kvkkCheck" required class="mt-0.5 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500" />
                <span>
                  <a href="/kvkk-aydinlatma-metni" target="_blank" class="text-emerald-600 hover:underline font-medium">KVKK Aydınlatma Metni</a>’ni okudum, onaylıyorum. *
                </span>
              </label>

              <label class="flex items-start gap-2.5 cursor-pointer">
                <input type="checkbox" id="explicitConsentCheck" required class="mt-0.5 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500" />
                <span>
                  <a href="/acik-riza-metni" target="_blank" class="text-emerald-600 hover:underline font-medium">Açık Rıza Metni</a>’ni okudum, onaylıyorum. *
                </span>
              </label>

              <label class="flex items-start gap-2.5 cursor-pointer">
                <input type="checkbox" id="commitmentCheck" required class="mt-0.5 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500" />
                <span>
                  <a href="/kisisel-verilerin-aktarimi-taahhutname" target="_blank" class="text-emerald-600 hover:underline font-medium">Kişisel Verilerin Aktarımına İlişkin Taahhütname</a>’yi kabul ediyorum. *
                </span>
              </label>
            </div>

            <button type="submit" id="submitBtn" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-500 text-white font-medium rounded-xl text-sm transition-all shadow-lg shadow-emerald-600/20 cursor-pointer">
              Mesajı Gönder
            </button>
          </form>
        </div>

      </div>

    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('contactForm');
      const alertBox = document.getElementById('formAlert');
      const submitBtn = document.getElementById('submitBtn');

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (alertBox) alertBox.classList.add('hidden');

          if (submitBtn) {
            submitBtn.setAttribute('disabled', 'true');
            submitBtn.textContent = 'Gönderiliyor...';
          }

          try {
            await new Promise((resolve) => setTimeout(resolve, 800));

            if (alertBox) {
              alertBox.textContent = 'Mesajınız başarıyla gönderildi. En kısa sürede dönüş sağlanacaktır.';
              alertBox.className = 'p-4 rounded-xl text-sm bg-emerald-50 border border-emerald-200 text-emerald-700';
              alertBox.classList.remove('hidden');
            }
            form.reset();
          } catch (err) {
            if (alertBox) {
              alertBox.textContent = 'Mesaj gönderilirken bir hata oluştu. Lütfen daha sonra tekrar deneyin.';
              alertBox.className = 'p-4 rounded-xl text-sm bg-red-50 border border-red-200 text-red-700';
              alertBox.classList.remove('hidden');
            }
          } finally {
            if (submitBtn) {
              submitBtn.removeAttribute('disabled');
              submitBtn.textContent = 'Mesajı Gönder';
            }
          }
        });
      }
    });
  </script>
</Layout>