---
export const prerender = true; // 🚀 Statik build edilerek performans ve hız optimize edildi
import Layout from '../../layouts/Layout.astro';

// SMMM ve Mali Süreçlerde En Çok İhtiyaç Duyulan Resmi Bağlantılar
const resmiPortallar = [
  { 
    title: "Dijital Vergi Dairesi", 
    url: "https://dijital.gib.gov.tr/", 
    icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 011-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6", 
    desc: "Vergi dairesi borç sorgulama, tebligat ve beyanname işlemleri portali." 
  },
  { 
    title: "SGK İşveren Sistemi", 
    url: "https://uyg.sgk.gov.tr/IsverenSistemi", 
    icon: "M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z", 
    desc: "Sigorta prim bildirgesi, teşvik sorgulama ve personel işveren portalı." 
  },
  { 
    title: "e-Devlet Kapısı", 
    url: "https://www.turkiye.gov.tr", 
    icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6", 
    desc: "Kamu hizmetleri, belge doğrulama ve resmi kurum sorgulamaları." 
  },
  { 
    title: "Vergi Takvimi (GİB)", 
    url: "https://gib.gov.tr/vergi-takvimi", 
    icon: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z", 
    desc: "Aylık beyanname, bildirim ve vergi ödeme son gün takibi." 
  },
  { 
    title: "E-Beyanname Sistemi", 
    url: "https://ebeyanname.gib.gov.tr", 
    icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z", 
    desc: "Mali müşavir beyanname gönderim ve resmi onay portali." 
  },
  { 
    title: "Ticaret Sicil Gazetesi", 
    url: "https://www.ticaretsicil.gov.tr", 
    icon: "M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z", 
    desc: "Şirket kuruluş, adres ve ana sözleşme değişiklik tescil ilanları." 
  },
  { 
    title: "TCMB Günlük Kurlar", 
    url: "https://www.tcmb.gov.tr/kurlar/kurlar_tr.html", 
    icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z", 
    desc: "Merkez Bankası gösterge niteliğindeki günlük resmi döviz kurları." 
  },
  { 
    title: "GİB E-Defter Portalı", 
    url: "https://edefter.gov.tr", 
    icon: "M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z", 
    desc: "E-Defter berat yükleme ve yasal mevzuat bilgi alma platformu." 
  },
  { 
    title: "Antalya Ticaret Odası (ATSO)", 
    url: "https://www.atso.org.tr/tr", 
    icon: "M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z", 
    desc: "Oda kayıt sicil sureti ve faaliyet belgesi online başvuru ekranı." 
  }
];

// Hesaplama ve Pratik Tablo Rehberleri
const pratikRehberler = [
  { 
    title: "Asgari Ücret Parametreleri", 
    url: "https://www.csgb.gov.tr/tr/poco-pages/asgari-ucret/", 
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z", 
    desc: "Çalışma Bakanlığı güncel ve geçmiş dönem brüt/net asgari ücret verileri." 
  },
  { 
    title: "GİB Hazır Beyan Sistemi", 
    url: "https://hazirbeyan.gib.gov.tr", 
    icon: "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z", 
    desc: "Gayrimenkul sermaye iradı (Kira geliri) ve menkul sermaye iradı beyan ekranı." 
  },
  { 
    title: "GİB E-Arşiv Portal Ekranı", 
    url: "https://earsivportal.efatura.gov.tr/intragiris.html", 
    icon: "M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2zM9 9h6m-6 4h6m-6 4h4", 
    desc: "Gelir İdaresi Başkanlığı portalı üzerinden e-Arşiv fatura düzenleme." 
  }
];
---

<Layout title="Pratik Araçlar & Resmi Bağlantılar | SMMM Samet Can Tulum">
  <main class="bg-slate-50 text-slate-800 min-h-screen">
    
    <!-- 1. HERO / BAŞLIK ALANI -->
    <section class="bg-white border-b border-slate-200/80 py-12 lg:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/60 text-emerald-700 text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Kamu Bağlantıları & Dijital Kaynaklar
          </div>
          <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
            Pratik Araçlar ve <br />
            <span class="text-emerald-600">Resmi Bağlantı</span> Portalı
          </h1>
          <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
            Günlük mali, finansal ve vergi süreçlerinizde ihtiyaç duyabileceğiniz resmi kamu portalları, vergi takvimi ve pratik sorgulama bağlantıları bilgilendirme amacıyla derlenmiştir.
          </p>
        </div>
      </div>
    </section>

    <!-- 2. RESMİ KAMU PORTALLARI GRID -->
    <section class="py-12 lg:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div class="border-b border-slate-200/80 pb-3">
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">
          Resmi Portallar & Kamu Kurumları
        </h2>
        <p class="text-slate-500 text-xs sm:text-sm mt-1">
          Beyanname, bildirge, vergi ve tescil işlemleriniz için doğrudan resmi kurum adresleri.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {resmiPortallar.map((item) => (
          <a 
            href={item.url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="p-5 rounded-2xl bg-white border border-slate-200/80 hover:border-emerald-500/40 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 group flex items-start gap-4"
          >
            <!-- Vector Icon -->
            <div class="w-12 h-12 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-600 group-hover:border-emerald-100 transition-colors shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
            </div>

            <div class="space-y-1">
              <h3 class="font-bold text-sm text-slate-900 group-hover:text-emerald-600 transition-colors flex items-center gap-1.5">
                <span>{item.title}</span>
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-emerald-600 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                {item.desc}
              </p>
            </div>
          </a>
        ))}
      </div>

    </section>

    <!-- 3. HESAPLAMA VE PRATİK VERİ REHBERİ -->
    <section class="py-12 bg-slate-100/70 border-t border-b border-slate-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
        
        <div class="border-b border-slate-200/80 pb-3">
          <h2 class="text-2xl font-bold text-slate-900 tracking-tight">
            Faydalı Doğrulama ve Sorgulama Araçları
          </h2>
          <p class="text-slate-500 text-xs sm:text-sm mt-1">
            Fatura düzenleme, asgari ücret parametreleri ve beyan takip sistemleri.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {pratikRehberler.map((item) => (
            <a 
              href={item.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="p-5 rounded-2xl bg-white border border-slate-200/80 hover:border-emerald-500/40 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 group flex items-start gap-4"
            >
              <div class="w-12 h-12 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-600 group-hover:border-emerald-100 transition-colors shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
              </div>

              <div class="space-y-1">
                <h3 class="font-bold text-sm text-slate-900 group-hover:text-emerald-600 transition-colors flex items-center gap-1.5">
                  <span>{item.title}</span>
                  <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-emerald-600 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </h3>
                <p class="text-xs text-slate-500 leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </a>
          ))}
        </div>

      </div>
    </section>

    <!-- 4. İLETİŞİM / DESTEK BANNER -->
    <section class="py-12 bg-white border-t border-slate-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-slate-900 rounded-2xl p-8 sm:p-10 text-white flex flex-col lg:flex-row items-center justify-between gap-6 shadow-xl relative overflow-hidden">
          
          <div class="space-y-2 text-center lg:text-left z-10">
            <h3 class="text-xl sm:text-2xl font-bold">
              Mevzuatsal Sorularınız mı Var?
            </h3>
            <p class="text-slate-300 text-xs sm:text-sm max-w-2xl leading-relaxed">
              Resmi süreçler, e-dönüşüm yükümlülükleri ve vergi beyan dönemleri ile ilgili resmi prosedürler hakkında bilgi almak için büromuzla iletişime geçebilirsiniz.
            </p>
          </div>
          
          <a 
            href="/iletisim" 
            class="z-10 px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold transition-all text-xs sm:text-sm shrink-0 shadow-md hover:shadow-emerald-600/20"
          >
            İletişime Geçin →
          </a>
        </div>

        <!-- 5. DIŞ BAĞLANTI & ETİK BİLGİLENDİRME DİPNOTU -->
        <div class="mt-8 pt-6 border-t border-slate-100 text-center">
          <p class="text-[11px] text-slate-400 leading-relaxed max-w-4xl mx-auto">
            <strong>Yasal Bilgilendirme:</strong> Bu sayfada yer alan yönlendirmeler ilgili resmi kamu kurumlarının (`gib.gov.tr`, `sgk.gov.tr`, `turkiye.gov.tr` vb.) doğrudan bağlantılarıdır. Sunulan harici içeriklerin güncelliği ve doğruluğu ilgili kurumların sorumluluğundadır. Sayfa, yalnızca bilgilendirme amacı taşımaktadır.
          </p>
        </div>

      </div>
    </section>

  </main>
</Layout>