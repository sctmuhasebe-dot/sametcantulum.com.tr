---
// client/src/pages/pratik-araclar/kidem-ihbar-tazminati.astro
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import DisclaimerNote from '../../components/common/DisclaimerNote.astro';

const PUBLIC_API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:5000/api';
---

<Layout title="2026 Kıdem ve İhbar Tazminatı Hesaplama Robotu | Samet Can Tulum">
  <section class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-6">
    
    <!-- Üst Başlık -->
    <div class="border-b border-slate-200 dark:border-slate-800 pb-5">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-xs font-bold font-mono">2026 MEVZUAT</span>
        <span class="text-xs text-slate-500 dark:text-slate-400">1475 Sayılı İş Kanunu Md. 14 & 4857 Sayılı Kanun Md. 17 Uyumlu</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Kıdem ve İhbar Tazminatı Hesaplama Motoru
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm mt-1">
        Giydirilmiş brüt ücret üzerinden tavan sınırları, çalışma süresi, gelir ve damga vergisi kesintileri otomatik hesaplanır.
      </p>
    </div>

    <!-- ANA FORM VE ÖZET ALANI -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- SOL KOLON: Form Parametreleri -->
      <div class="lg:col-span-5 bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 rounded-xl p-5 shadow-sm space-y-5">
        <div class="border-b border-slate-200 dark:border-slate-700/80 pb-3 flex items-center justify-between">
          <h2 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
            <span class="text-emerald-500">📝</span> Çalışma Bilgileri
          </h2>
          <span class="text-[11px] text-slate-400">Tavan Kontrollü</span>
        </div>

        <form id="severance-form" class="space-y-4">
          <!-- Tarih Bilgileri -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="startDate" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">İşe Başlama Tarihi</label>
              <input
                type="date"
                id="startDate"
                name="startDate"
                required
                class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-xs font-semibold text-slate-900 dark:text-white focus:outline-none focus:border-emerald-500"
              />
            </div>
            <div>
              <label for="endDate" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">İşten Ayrılış Tarihi</label>
              <input
                type="date"
                id="endDate"
                name="endDate"
                required
                class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-xs font-semibold text-slate-900 dark:text-white focus:outline-none focus:border-emerald-500"
              />
            </div>
          </div>

          <!-- Brüt Ücret -->
          <div>
            <label for="grossSalary" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
              Son Çıplak Brüt Ücret (TL)
            </label>
            <div class="relative">
              <input
                type="number"
                id="grossSalary"
                name="grossSalary"
                min="0"
                step="0.01"
                placeholder="33030.00"
                required
                class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3.5 py-2.5 text-sm font-semibold text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-emerald-500"
              />
              <span class="absolute right-3 top-2.5 text-xs text-slate-400 font-bold">₺ / Ay</span>
            </div>
          </div>

          <!-- Ek Yan Haklar -->
          <div>
            <label for="additionalBenefits" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
              Aylık Düzenli Ek Olanaklar / Yan Haklar (TL)
            </label>
            <input
              type="number"
              id="additionalBenefits"
              name="additionalBenefits"
              min="0"
              step="0.01"
              placeholder="Yemek, yol, ikramiye vb. aylık ortalaması"
              value="0"
              class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3.5 py-2 text-xs font-semibold text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-emerald-500"
            />
            <span class="text-[10px] text-slate-500 dark:text-slate-400 mt-1 block">Brüt ücrete eklenerek giydirilmiş brüt ücret oluşturulur.</span>
          </div>

          <!-- İhbar Tazminatı Seçeneği -->
          <div class="pt-2 border-t border-slate-200 dark:border-slate-700/60">
            <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-slate-700 dark:text-slate-200">
              <input
                type="checkbox"
                id="includeNotice"
                name="includeNotice"
                checked
                class="w-4 h-4 rounded bg-white dark:bg-slate-900 border-slate-300 dark:border-slate-700 text-emerald-600 focus:ring-emerald-500 accent-emerald-500"
              />
              <span>İhbar Tazminatı Hesaplamaya Dahil Edilsin</span>
            </label>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 px-4 rounded-lg transition-all text-xs uppercase tracking-wider shadow-md shadow-emerald-500/10 flex items-center justify-center gap-2 cursor-pointer"
          >
            <span id="btn-text">Tazminat Hesapla</span>
            <div id="btn-spinner" class="hidden w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
          </button>
        </form>

        <div id="error-box" class="hidden p-3 bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 rounded-lg text-xs text-center font-medium"></div>
      </div>

      <!-- SAĞ KOLON: Özet Sonuç Kartları -->
      <div class="lg:col-span-7 bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 rounded-xl p-5 shadow-sm space-y-4">
        <div class="border-b border-slate-200 dark:border-slate-700/80 pb-3 flex items-center justify-between">
          <h2 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
            <span class="text-emerald-500">📊</span> Tazminat Hesaplama Sonuçları
          </h2>
          <span id="tenure-badge" class="text-[11px] font-mono bg-slate-100 dark:bg-slate-700 px-2 py-0.5 rounded text-slate-700 dark:text-slate-300">Süre: -</span>
        </div>

        <div id="summary-placeholder" class="py-16 text-center text-xs text-slate-400">
          Tazminat tutarlarını hesaplamak için çalışma tarihlerini ve ücret bilgilerini giriniz.
        </div>

        <div id="summary-results" class="hidden space-y-4">
          <!-- Genel Toplam Kartı -->
          <div class="bg-emerald-500/10 border border-emerald-500/30 p-4 rounded-xl flex items-center justify-between">
            <div>
              <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">Net Ele Geçen Toplam Tazminat</span>
              <p id="total-net-payout" class="text-2xl font-extrabold text-slate-900 dark:text-white mt-0.5">0,00 ₺</p>
            </div>
            <button id="print-btn" type="button" class="px-3 py-1.5 bg-slate-800 dark:bg-slate-700 hover:bg-slate-700 dark:hover:bg-slate-600 text-white rounded text-xs font-semibold transition-colors cursor-pointer">
              🖨️ Yazdır
            </button>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Kıdem Tazminatı Detay Kartı -->
            <div class="bg-slate-50 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-700/80 p-4 rounded-lg space-y-2">
              <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-800 pb-2">
                <h3 class="font-bold text-xs text-slate-800 dark:text-slate-200 uppercase">Kıdem Tazminatı</h3>
                <span id="severance-tavan-applied" class="text-[10px] text-amber-600 dark:text-amber-400 hidden font-semibold">Tavan Aşıldı!</span>
              </div>
              <div class="flex justify-between text-xs text-slate-600 dark:text-slate-400">
                <span>Esas Giydirilmiş Brüt:</span>
                <span id="severance-basis" class="font-mono text-slate-900 dark:text-white">0,00 ₺</span>
              </div>
              <div class="flex justify-between text-xs text-slate-600 dark:text-slate-400">
                <span>Brüt Kıdem Tutarı:</span>
                <span id="severance-gross" class="font-mono text-slate-900 dark:text-white">0,00 ₺</span>
              </div>
              <div class="flex justify-between text-xs text-slate-600 dark:text-slate-400">
                <span>Damga Vergisi (%0.759):</span>
                <span id="severance-tax" class="font-mono text-rose-600 dark:text-rose-400">0,00 ₺</span>
              </div>
              <div class="flex justify-between text-xs font-bold text-emerald-600 dark:text-emerald-400 border-t border-slate-200 dark:border-slate-800 pt-2">
                <span>Net Kıdem Tazminatı:</span>
                <span id="severance-net" class="font-mono">0,00 ₺</span>
              </div>
            </div>

            <!-- İhbar Tazminatı Detay Kartı -->
            <div class="bg-slate-50 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-700/80 p-4 rounded-lg space-y-2">
              <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-800 pb-2">
                <h3 class="font-bold text-xs text-slate-800 dark:text-slate-200 uppercase">İhbar Tazminatı</h3>
                <span id="notice-weeks" class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold">- Haftalık</span>
              </div>
              <div class="flex justify-between text-xs text-slate-600 dark:text-slate-400">
                <span>Brüt İhbar Tutarı:</span>
                <span id="notice-gross" class="font-mono text-slate-900 dark:text-white">0,00 ₺</span>
              </div>
              <div class="flex justify-between text-xs text-slate-600 dark:text-slate-400">
                <span>Gelir Vergisi (Dilime Göre):</span>
                <span id="notice-income-tax" class="font-mono text-rose-600 dark:text-rose-400">0,00 ₺</span>
              </div>
              <div class="flex justify-between text-xs text-slate-600 dark:text-slate-400">
                <span>Damga Vergisi (%0.759):</span>
                <span id="notice-stamp-tax" class="font-mono text-rose-600 dark:text-rose-400">0,00 ₺</span>
              </div>
              <div class="flex justify-between text-xs font-bold text-emerald-600 dark:text-emerald-400 border-t border-slate-200 dark:border-slate-800 pt-2">
                <span>Net İhbar Tazminatı:</span>
                <span id="notice-net" class="font-mono">0,00 ₺</span>
              </div>
            </div>
          </div>

          <div class="p-3 bg-slate-100 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 rounded-lg text-[11px] text-slate-600 dark:text-slate-400 space-y-1">
            <p>💡 <strong>Yasal Not:</strong> Kıdem tazminatı Gelir Vergisi'nden müstesnadır, sadece <strong>%0.759 (Binde 7.59)</strong> Damga Vergisi kesilir. İhbar tazminatı ise Gelir Vergisi ve Damga Vergisi kesintisine tabidir.</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Yasal Uyarı / Bilgilendirme Notu -->
    <DisclaimerNote />

  </section>
</Layout>

<script define:vars={{ PUBLIC_API_URL }}>
  const formatTL = (val) => {
    return new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY' }).format(val || 0);
  };

  const initSeveranceForm = () => {
    const form = document.getElementById('severance-form');
    if (!form || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    const submitBtn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');
    const errorBox = document.getElementById('error-box');

    const summaryPlaceholder = document.getElementById('summary-placeholder');
    const summaryResults = document.getElementById('summary-results');
    const printBtn = document.getElementById('print-btn');

    printBtn?.addEventListener('click', () => window.print());

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      errorBox.classList.add('hidden');
      btnText.textContent = 'Hesaplanıyor...';
      btnSpinner.classList.remove('hidden');
      submitBtn.disabled = true;

      const formData = new FormData(form);

      const payload = {
        startDate: formData.get('startDate'),
        endDate: formData.get('endDate'),
        grossSalary: Number(formData.get('grossSalary')),
        additionalBenefits: Number(formData.get('additionalBenefits') || 0),
        includeNotice: formData.get('includeNotice') === 'on'
      };

      try {
        const response = await fetch(`${PUBLIC_API_URL}/tools/calculate-severance`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || 'Hesaplama yapılırken bir hata oluştu.');
        }

        const { data } = result;

        // Süre Rozetini Güncelle
        const tenureBadge = document.getElementById('tenure-badge');
        if (tenureBadge && data.duration) {
          tenureBadge.textContent = `Süre: ${data.duration.years || 0} Yıl ${data.duration.months || 0} Ay ${data.duration.days || 0} Gün`;
        }

        // Kıdem Bilgileri
        document.getElementById('severance-basis').textContent = formatTL(data.severance.basisBrut);
        document.getElementById('severance-gross').textContent = formatTL(data.severance.gross);
        document.getElementById('severance-tax').textContent = formatTL(data.severance.stampTax);
        document.getElementById('severance-net').textContent = formatTL(data.severance.net);

        const tavanBadge = document.getElementById('severance-tavan-applied');
        if (tavanBadge) {
          if (data.severance.tavanApplied) {
            tavanBadge.classList.remove('hidden');
          } else {
            tavanBadge.classList.add('hidden');
          }
        }

        // İhbar Bilgileri
        document.getElementById('notice-weeks').textContent = `${data.notice.weeks || 0} Haftalık`;
        document.getElementById('notice-gross').textContent = formatTL(data.notice.gross);
        document.getElementById('notice-income-tax').textContent = formatTL(data.notice.incomeTax);
        document.getElementById('notice-stamp-tax').textContent = formatTL(data.notice.stampTax);
        document.getElementById('notice-net').textContent = formatTL(data.notice.net);

        // Toplam Ödeme
        document.getElementById('total-net-payout').textContent = formatTL(data.totalNetPayout);

        summaryPlaceholder.classList.add('hidden');
        summaryResults.classList.remove('hidden');

      } catch (err) {
        console.error('Tazminat Hesaplama Hatası:', err);
        errorBox.textContent = err.message || 'Bir bağlantı hatası oluştu. Lütfen sunucunun aktif olduğundan emin olun.';
        errorBox.classList.remove('hidden');
      } finally {
        btnText.textContent = 'Tazminat Hesapla';
        btnSpinner.classList.add('hidden');
        submitBtn.disabled = false;
      }
    });
  };

  document.addEventListener('astro:page-load', initSeveranceForm);
  document.addEventListener('DOMContentLoaded', initSeveranceForm);
  initSeveranceForm();
</script>