---
// client/src/pages/pratik-araclar/gecikme-zammi.astro
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import DisclaimerNote from '../../components/common/DisclaimerNote.astro';
---

<Layout 
  title="Vergi ve SGK Gecikme Zammı Hesaplama | Samet Can Tulum, SMMM"
  description="Güncel gecikme zammı oranları ile vergi ve prim borçlarınızın gecikme faizini hesaplayın. Samet Can Tulum, Serbest Muhasebeci Mali Müşavir, Muratpaşa, Antalya."
>
  <section class="max-w-7xl mx-auto py-6 sm:py-8 px-3 sm:px-6 lg:px-8 space-y-6 bg-slate-50 dark:bg-slate-950 min-h-screen">
    
    <!-- Üst Başlık -->
    <div class="border-b border-slate-200 dark:border-slate-800 pb-4 sm:pb-5">
      <div class="flex flex-wrap items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 rounded bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20 text-xs font-bold font-mono">2026 GÜNCEL</span>
        <span class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400">Vergi, SGK ve Kamu Alacakları Uyumlu</span>
      </div>
      <h1 class="text-xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Gecikme Zammı & Faizi Hesaplama Motoru
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm mt-1">
        Vergi, SGK ve diğer kamu alacaklarınız için yasal oranlar üzerinden günlük ve aylık bazda gecikme zammı tutarını otomatik hesaplayın.
      </p>
    </div>

    <!-- ANA FORM VE ÖZET ALANI -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- SOL KOLON: Form Parametreleri -->
      <div class="lg:col-span-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-4 sm:p-5 shadow-sm space-y-4 sm:space-y-5">
        <div class="border-b border-slate-200 dark:border-slate-800 pb-3 flex items-center justify-between">
          <h2 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
            <span class="text-blue-500">📝</span> Alacak ve Tarih Bilgileri
          </h2>
          <span class="text-[11px] text-slate-400 font-mono">Oran Kontrollü</span>
        </div>

        <form id="calcForm" class="space-y-4">
          <!-- Asıl Alacak Tutarı -->
          <div>
            <label for="amount" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
              Asıl Alacak Tutarı (TL)
            </label>
            <div class="relative flex items-center">
              <input
                type="number"
                id="amount"
                name="amount"
                step="0.01"
                min="0"
                placeholder="50000.00"
                required
                class="w-full bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg px-3.5 py-2.5 pr-14 text-sm font-semibold text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
              />
              <span class="absolute right-3 text-xs text-slate-400 font-bold pointer-events-none">₺</span>
            </div>
          </div>

          <!-- Tarih Bilgileri -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="dueDate" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Vade / Son Ödeme</label>
              <input
                type="date"
                id="dueDate"
                name="dueDate"
                required
                class="w-full bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg px-3 py-2.5 text-xs font-semibold text-slate-900 dark:text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
              />
            </div>
            <div>
              <label for="paymentDate" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Ödeme / Hesap Tarihi</label>
              <input
                type="date"
                id="paymentDate"
                name="paymentDate"
                required
                class="w-full bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg px-3 py-2.5 text-xs font-semibold text-slate-900 dark:text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
              />
            </div>
          </div>

          <!-- Uygulanacak Aylık Oran -->
          <div>
            <label for="monthlyRate" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
              Uygulanacak Aylık Oran (%)
            </label>
            <div class="relative flex items-center">
              <input
                type="number"
                id="monthlyRate"
                name="monthlyRate"
                step="0.01"
                min="0"
                value="4.50"
                required
                class="w-full bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg px-3.5 py-2.5 pr-14 text-sm font-semibold text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
              />
              <span class="absolute right-3 text-xs text-slate-400 font-bold pointer-events-none">% / Ay</span>
            </div>
            <span class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 block">Resmi Gazete yasal oranlarına göre güncelleyebilirsiniz.</span>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3.5 px-4 rounded-lg transition-all text-xs uppercase tracking-wider shadow-md shadow-blue-500/10 flex items-center justify-center gap-2 cursor-pointer"
          >
            <span id="btn-text">Gecikme Zammı Hesapla</span>
            <div id="btn-spinner" class="hidden w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
          </button>
        </form>

        <div id="error-box" class="hidden p-3 bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 rounded-lg text-xs font-medium space-y-1"></div>
      </div>

      <!-- SAĞ KOLON: Özet Sonuç Kartları -->
      <div class="lg:col-span-7 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-4 sm:p-5 shadow-sm space-y-4">
        <div class="border-b border-slate-200 dark:border-slate-800 pb-3 flex items-center justify-between">
          <h2 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
            <span class="text-blue-500">📊</span> Hesaplama Özeti ve Sonuçlar
          </h2>
          <span id="resRate-badge" class="text-[11px] font-mono bg-slate-100 dark:bg-slate-950 px-2.5 py-0.5 rounded border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">Oran: -</span>
        </div>

        <div id="placeholder" class="py-12 text-center text-xs text-slate-400">
          Gecikme zammı ve toplam tutarı hesaplamak için ilgili tarihleri ve asıl alacak tutarını giriniz.
        </div>

        <div id="results" class="hidden space-y-4">
          <!-- Genel Toplam Kartı -->
          <div class="bg-blue-500/10 border border-blue-500/30 p-4 rounded-xl flex flex-wrap items-center justify-between gap-3">
            <div>
              <span class="text-[11px] font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider">Toplam Ödenecek Tutar</span>
              <p id="resTotalPayout" class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mt-0.5 truncate">0,00 ₺</p>
            </div>
            <button id="print-btn" type="button" class="px-3 py-1.5 bg-slate-800 dark:bg-slate-700 hover:bg-slate-700 dark:hover:bg-slate-600 text-white rounded text-xs font-semibold transition-colors flex items-center gap-1.5 cursor-pointer">
              <span>🖨️</span> Yazdır / PDF
            </button>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <!-- Süre ve Oran Bilgisi -->
            <div class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-3.5 rounded-lg space-y-2">
              <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-800 pb-2">
                <h3 class="font-bold text-xs text-slate-800 dark:text-slate-200 uppercase">Zaman Analizi</h3>
                <span id="resTotalDays" class="text-[10px] text-blue-600 dark:text-blue-400 font-semibold bg-blue-500/10 px-1.5 py-0.5 rounded border border-blue-500/20">Toplam 0 Gün</span>
              </div>
              <div class="flex justify-between text-xs text-slate-600 dark:text-slate-400 gap-2">
                <span>Gecikilen Süre:</span>
                <span id="resDuration" class="font-mono text-slate-900 dark:text-white font-semibold truncate">0 Ay 0 Gün</span>
              </div>
              <div class="flex justify-between text-xs text-slate-600 dark:text-slate-400 gap-2">
                <span>Uygulanan Aylık Oran:</span>
                <span id="resRate" class="font-mono text-slate-900 dark:text-white font-semibold truncate">%0</span>
              </div>
            </div>

            <!-- Tutar Detay Kartı -->
            <div class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-3.5 rounded-lg space-y-2">
              <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-800 pb-2">
                <h3 class="font-bold text-xs text-slate-800 dark:text-slate-200 uppercase">Alacak Detayları</h3>
                <span class="text-[10px] text-amber-600 dark:text-amber-400 font-semibold bg-amber-500/10 px-1.5 py-0.5 rounded border border-amber-500/20">Yasal Esas</span>
              </div>
              <div class="flex justify-between text-xs text-slate-600 dark:text-slate-400 gap-2">
                <span>Asıl Alacak Tutarı:</span>
                <span id="resPrincipal" class="font-mono text-slate-900 dark:text-white font-semibold truncate">0,00 ₺</span>
              </div>
              <div class="flex justify-between text-xs text-slate-600 dark:text-slate-400 gap-2">
                <span>Hesaplanan Gecikme Zammı:</span>
                <span id="resPenalty" class="font-mono text-amber-600 dark:text-amber-400 font-semibold truncate">0,00 ₺</span>
              </div>
            </div>
          </div>

          <div class="p-3 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg text-xs text-slate-600 dark:text-slate-400 space-y-1">
            <p>💡 <strong>Yasal Not:</strong> Gecikme zammı hesaplamalarında kesirli aylar için gün esasına göre oranlama yapılır. Resmi kurum bildirgelerinde güncel katsayılar esas alınmalıdır.</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Yasal Uyarı / Bilgilendirme Notu -->
    <DisclaimerNote />

  </section>
</Layout>

<script>
  const formatTL = (val: number) => {
    return new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY' }).format(val || 0);
  };

  const initLateFeeForm = () => {
    const form = document.getElementById('calcForm') as HTMLFormElement;
    if (!form || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');
    const errorBox = document.getElementById('error-box');

    const placeholder = document.getElementById('placeholder');
    const results = document.getElementById('results');
    const printBtn = document.getElementById('print-btn');

    printBtn?.addEventListener('click', () => window.print());

    const paymentDateInput = document.getElementById('paymentDate') as HTMLInputElement;
    if (paymentDateInput && !paymentDateInput.value) {
      paymentDateInput.valueAsDate = new Date();
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!errorBox || !btnText || !btnSpinner || !placeholder || !results) return;

      errorBox.classList.add('hidden');
      errorBox.textContent = '';

      btnText.textContent = 'Hesaplanıyor...';
      btnSpinner.classList.remove('hidden');
      submitBtn.disabled = true;

      try {
        const formData = new FormData(form);
        const amount = Number(formData.get('amount'));
        const dueDateStr = formData.get('dueDate') as string;
        const paymentDateStr = formData.get('paymentDate') as string;
        const monthlyRate = Number(formData.get('monthlyRate'));

        const start = new Date(dueDateStr);
        const end = new Date(paymentDateStr);

        if (start > end) {
          throw new Error('Ödeme / hesap tarihi, vade tarihinden önce olamaz.');
        }

        let years = end.getFullYear() - start.getFullYear();
        let months = end.getMonth() - start.getMonth();
        let days = end.getDate() - start.getDate();

        if (days < 0) {
          months--;
          const prevMonth = new Date(end.getFullYear(), end.getMonth(), 0);
          days += prevMonth.getDate();
        }
        if (months < 0) {
          years--;
          months += 12;
        }

        const totalDays = Math.floor((end.getTime() - start.getTime()) / (1000 * 60 * 60 * 24)) + 1;
        const totalMonths = (years * 12) + months + (days / 30);
        
        const dailyRate = monthlyRate / 30;
        const lateFee = amount * (monthlyRate / 100) * (totalMonths);
        const totalPayout = amount + lateFee;

        // UI Güncellemeleri
        document.getElementById('resPrincipal')!.textContent = formatTL(amount);
        document.getElementById('resPenalty')!.textContent = formatTL(lateFee);
        document.getElementById('resTotalPayout')!.textContent = formatTL(totalPayout);
        document.getElementById('resDuration')!.textContent = `${years > 0 ? `${years} Yıl ` : ''}${months} Ay ${days} Gün`;
        document.getElementById('resTotalDays')!.textContent = `Toplam ${totalDays} Gün`;
        document.getElementById('resRate')!.textContent = `%${monthlyRate.toFixed(2)}`;
        
        const rateBadge = document.getElementById('resRate-badge');
        if (rateBadge) {
          rateBadge.textContent = `Oran: %${monthlyRate.toFixed(2)}`;
        }

        placeholder.classList.add('hidden');
        results.classList.remove('hidden');

      } catch (err: any) {
        console.error('Gecikme Zammı Hesaplama Hatası:', err);
        if (errorBox) {
          errorBox.textContent = err.message || 'Hesaplama yapılırken bir hata oluştu.';
          errorBox.classList.remove('hidden');
        }
      } finally {
        if (btnText) btnText.textContent = 'Gecikme Zammı Hesapla';
        if (btnSpinner) btnSpinner.classList.add('hidden');
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  };

  document.addEventListener('astro:page-load', initLateFeeForm);
  document.addEventListener('DOMContentLoaded', initLateFeeForm);
  initLateFeeForm();
</script>