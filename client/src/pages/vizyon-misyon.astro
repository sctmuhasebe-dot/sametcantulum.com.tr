---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

const uzmanlikAlanlari = [
  { icon: "💼", title: "Mali Müşavirlik & Muhasebe", desc: "Vergi beyannameleri, bildirgeler ve yasal mevzuat uyum süreçleri." },
  { icon: "🏛️", title: "Şirket Kuruluş Süreçleri", desc: "Şahıs, Limited ve Anonim şirket kuruluşları ile hukuki tescil işlemleri." },
  { icon: "💻", title: "E-Dönüşüm & Dijital", desc: "e-Fatura, e-Arşiv ve dijital muhasebe entegrasyonları." },
  { icon: "📊", title: "Mali Danışmanlık", desc: "Teşvik analizi, finansal tablo yorumlama ve stratejik danışmanlık." }
];
---

<Layout title="Vizyon & Misyon | Samet Can Tulum" description="Vizyonumuz ve sunduğumuz uzmanlık alanları.">
  <main class="min-h-screen py-16">
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <h1 class="text-3xl font-bold text-slate-900 mb-12 text-center">Vizyon & Misyon</h1>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="p-8 bg-slate-900 text-white rounded-2xl">
          <h2 class="text-xl font-bold mb-4 text-emerald-400">Vizyonumuz</h2>
          <p class="text-slate-300">Dijitalleşen dünyada, finansal süreçleri şeffaf, anlaşılır ve erişilebilir kılarak işletmelerin sürdürülebilir büyümesine rehberlik eden öncü ve yenilikçi bir mali müşavirlik pratiği oluşturmak.</p>
        </div>
        <div class="p-8 bg-emerald-700 text-white rounded-2xl">
          <h2 class="text-xl font-bold mb-4 text-emerald-50">Misyonumuz</h2>
          <p class="text-emerald-50">Mükelleflerimize veri odaklı analizler, risk yönetimi ve teknolojik entegrasyonlarla işletmelerini bir adım öne taşıyacak stratejik danışmanlık sunmak.</p>
        </div>
      </div>
    </section>

    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-8">Uzmanlık Alanları</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {uzmanlikAlanlari.map((hizmet) => (
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="text-3xl mb-4">{hizmet.icon}</div>
            <h3 class="font-bold text-slate-900 mb-2">{hizmet.title}</h3>
            <p class="text-slate-600 text-sm">{hizmet.desc}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>