---
import Navbar from '../components/common/Navbar.astro';
import CookieBanner from '../components/common/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const { 
  title = "Samet Can Tulum | Serbest Muhasebeci Mali Müşavir", 
  description = "Mali müşavirlik, vergi danışmanlığı, defter tutma ve finansal süreçleriniz için profesyonel çözümler.",
  image = "/og-image.jpg",
  canonicalURL = Astro.url.href
} = Astro.props;
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Search Console Doğrulama Etiketi -->
    <meta name="google-site-verification" content="iIJXAI_oQx52LveBdBOO7rOlgKkD36K-O0Usx1CLrSk" />

    <!-- SEO Meta Etiketleri -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Sosyal Medya Paylaşım Etiketleri -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:locale" content="tr_TR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

   
    <!-- Yerel SEO ve Kişisel İşletme Yapısal Verisi (JSON-LD) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "AccountingService",
            "@id": "https://www.sametcantulum.com.tr/#organization",
            "name": "SMMM Samet Can Tulum | Mali Müşavirlik",
            "url": "https://www.sametcantulum.com.tr",
            "logo": "https://www.sametcantulum.com.tr/images/logo.webp",
            "image": "https://www.sametcantulum.com.tr/og-image.jpg",
            "description": "Mali müşavirlik, vergi danışmanlığı, defter tutma ve finansal süreçleriniz için profesyonel çözümler.",
            "address": {
              "@type": "PostalAddress",
              "@id": "https://www.sametcantulum.com.tr/#address",
              "addressLocality": "Antalya",
              "addressRegion": "Antalya",
              "addressCountry": "TR"
            },
            "geo": {
              "@type": "GeoCoordinates",
              "addressCountry": "TR"
            },
            "telephone": "+905427846260",
            "email": "info@sametcantulum.com.tr",
            "priceRange": "$$"
          },
          {
            "@type": "Person",
            "@id": "https://www.sametcantulum.com.tr/#person",
            "name": "Samet Can Tulum",
            "jobTitle": "Serbest Muhasebeci Mali Müşavir",
            "worksFor": {
              "@id": "https://www.sametcantulum.com.tr/#organization"
            }
          }
        ]
      }
    </script>

    <!-- Google Analytics (GA4) & Çerez İzin Yönetimi -->
    <script is:inline>
      function loadGoogleAnalytics(trackingId) {
        if (window.gaLoaded) return;
        window.gaLoaded = true;

        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${trackingId}`;
        document.head.appendChild(script);

        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        window.gtag = gtag;
        
        gtag('js', new Date());
        gtag('config', trackingId);
      }

      const GA_TRACKING_ID = 'G-6HD4056JVK'; 

      const consent = localStorage.getItem('cookie_consent');
      if (consent === 'accepted') {
        loadGoogleAnalytics(GA_TRACKING_ID);
      }

      window.addEventListener('storage', (e) => {
        if (e.key === 'cookie_consent' && e.newValue === 'accepted') {
          loadGoogleAnalytics(GA_TRACKING_ID);
        }
      });
    </script>
  </head>
  
  <body class="bg-ink-50 text-ink-900 font-sans min-h-screen flex flex-col">

    <!-- Navigasyon Barı -->
    <Navbar />

    <!-- Ana İçerik Alanı -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Alt Bilgi / Footer (Erişilebilirlik için metin kontrastları artırıldı) -->
    <footer class="bg-ink-900 text-gray-300 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3 min-h-[220px]">

          <!-- Marka & Logo Alanı -->
          <div class="lg:col-span-2 space-y-3">
            <a href="/" class="flex items-center gap-3.5 group shrink-0 inline-flex">
              <div class="h-10 w-10 rounded-xl bg-white/90 border border-white/20 p-1 flex items-center justify-center shadow-md shadow-brand-500/10 group-hover:bg-white group-hover:scale-105 transition-all shrink-0 overflow-hidden">
                <img 
                  src="/images/logo.webp" 
                  alt="SMMM Samet Can Tulum Logo"
                  width="53"
                  height="53"
                  class="h-full w-full object-contain filter brightness-90 contrast-125 group-hover:brightness-100 transition-all"
                />
              </div>

              <div class="flex flex-col">
                <span class="font-bold text-base tracking-tight leading-none text-white group-hover:text-emerald-400 transition-colors">
                  Samet Can Tulum
                </span>
                <span class="text-[10px] text-gray-400 font-medium tracking-wider uppercase mt-1">
                  Serbest Muhasebeci Mali Müşavir
                </span>
              </div>
            </a>

            <p class="text-sm text-gray-300 max-w-sm leading-relaxed pt-1">
              Mali müşavirlik, vergi danışmanlığı ve dijital finansal süreçlerde güncel mevzuata uygun, danışmanlık hizmeti.
            </p>
          </div>

          <!-- Hizmetler Başlığı --> 
          <div>
            <h3 class="text-white font-semibold text-sm mb-4">Hizmetler</h3>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/hizmetler/mali-musavirlik" class="hover:text-white transition-colors">Mali Müşavirlik ve Muhasebe Hizmetleri</a></li>
              <li><a href="/hizmetler/vergi-danismanligi" class="hover:text-white transition-colors">Vergi Mevzuatı ve Mali Danışmanlık</a></li>
              <li><a href="/hizmetler/sirket-kurulusu" class="hover:text-white transition-colors">Ticaret Sicil ve Şirket Kuruluş İşlemleri</a></li>
              <li><a href="/hizmetler/sgk-ve-bordro" class="hover:text-white transition-colors">SGK ve Bordro Hizmetleri</a></li>
            </ul>
          </div>

          <!-- Kurumsal Başlığı --> 
          <div>
            <h3 class="text-white font-semibold text-sm mb-4">Kurumsal</h3>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/hakkimda" class="hover:text-white transition-colors">Hakkımızda</a></li>
              <li><a href="/hizmetler" class="hover:text-white transition-colors">Hizmetlerimiz</a></li>
              <li><a href="/sektorel-cozumler" class="hover:text-white transition-colors">Sektörel Çözümler</a></li>
              <li><a href="/yayinlar" class="hover:text-white transition-colors">Yayınlar</a></li>
            </ul>
          </div>

          <!-- Yasal Başlığı -->
          <div>
            <h3 class="text-white font-semibold text-sm mb-4">Yasal</h3>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/kvkk-aydinlatma-metni" class="hover:text-white transition-colors">KVKK Aydınlatma Metni</a></li>
              <li><a href="/acik-riza-metni" class="hover:text-white transition-colors">Açık Rıza Metni</a></li>
              <li><a href="/taahhutname" class="hover:text-white transition-colors">Kişisel Verilerin Aktarımına İlişkin Taahhütname</a></li>
              <li><a href="/cerez-politikasi" class="hover:text-white transition-colors">Çerez Politikası</a></li>
            </ul>
          </div>

          <!-- İletişim -->
          <div>
            <h3 class="text-white font-semibold text-sm mb-4">İletişim</h3>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/iletisim" class="hover:text-white transition-colors">Bize Ulaşın</a></li>
              <li><a href="tel:+905427846260" class="hover:text-white transition-colors">+90 (542) 784 62 60</a></li>
              <li><a href="mailto:info@sametcantulum.com.tr" class="hover:text-white transition-colors">info@sametcantulum.com.tr</a></li>
              <li class="text-gray-300">Antalya, Türkiye</li>
            </ul>
          </div>

        </div>

        <div class="mt-12 pt-6 border-t border-ink-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-400">
          <p>© {new Date().getFullYear()} Samet Can Tulum — Tüm hakları saklıdır.</p>
          <p>Mali Müşavirlik ve Danışmanlık Hizmetleri</p>
        </div>
      </div>
    </footer>

    <!-- Çerez Bildirim Bandı -->
    <CookieBanner />

  </body>
</html>