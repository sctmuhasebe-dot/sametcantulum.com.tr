---
// src/components/Breadcrumbs.astro
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

// Schema.org BreadcrumbList yapısı
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": new URL(item.url, Astro.site || Astro.url.origin).toString()
  }))
};
---

<!-- Görsel Breadcrumb -->
<nav aria-label="Breadcrumb" class="py-3 text-xs text-slate-500 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
  <ol class="flex items-center space-x-2 flex-wrap">
    {items.map((item, index) => (
      <li class="flex items-center">
        {index > 0 && <span class="mx-2 text-slate-400">/</span>}
        {index === items.length - 1 ? (
          <span class="text-slate-800 font-semibold" aria-current="page">{item.name}</span>
        ) : (
          <a href={item.url} class="hover:text-emerald-600 transition-colors">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<!-- JSON-LD Breadcrumb Schema -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />