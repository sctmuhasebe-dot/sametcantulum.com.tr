---
import { pratikAraclarListesi } from '../../data/pratikAraclar';
import { kurumsalListesi } from '../../data/kurumsal'; // <--- Kurumsal verisi eklendi

const menuGroups = [
  {
    label: "Kurumsal",
    href: "/kurumsal", // <--- Artık ana sayfaya yönlendiriliyor ve tıklanabilir
    items: kurumsalListesi, // <--- Merkezi dosyadan otomatik beslenir
  },
  {
    label: "Hizmetlerimiz",
    href: "/hizmetler",
    items: [
      { href: "/hizmetler/mali-musavirlik", icon: "📊", title: "Mali Müşavirlik ve Muhasebe" },
      { href: "/hizmetler/vergi-danismanligi", icon: "⚖️", title: "Vergi Müşavirliği ve Mevzuat" },
      { href: "/hizmetler/sirket-kurulusu", icon: "🏢", title: "Ticaret Sicil & Şirket Kuruluşu" },
      { href: "/hizmetler/sgk-ve-bordro", icon: "📋", title: "SGK ve Bordro Hesaplamaları" },
    ],
  },
  {
    label: "Pratik Araçlar",
    href: "/pratik-araclar",
    items: pratikAraclarListesi,
  },
  {
    label: "Yayinlar",
    href: "/yayinlar",
    items: [
      { href: "/yayinlar/kategori/mevzuat", icon: "⚖️", title: "Mevzuat & Resmi Yazılar" },
      { href: "/yayinlar/kategori/makaleler", icon: "📝", title: "Makaleler" },
      { href: "/yayinlar/kategori/blog", icon: "💡", title: "Blog & Sektörel Yorumlar" },
    ],
  },
];
---

<header class="bg-ink-900 border-b border-ink-800 text-white sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3.5 group shrink-0">
        <div class="h-10 w-10 rounded-xl bg-white/90 border border-white/20 p-1 flex items-center justify-center shadow-md shadow-brand-500/10 group-hover:bg-white group-hover:scale-105 transition-all shrink-0 overflow-hidden">
          <img src="/images/logo.png" alt="SMMM Samet Can Tulum Logo" width="53" height="53" class="h-full w-full object-contain filter brightness-90 contrast-125 group-hover:brightness-100 transition-all" />
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-base tracking-tight leading-none text-white group-hover:text-brand-400 transition-colors">Samet Can Tulum</span>
          <span class="text-[10px] text-ink-300 font-medium tracking-wider uppercase mt-1">Serbest Muhasebeci Mali Müşavir</span>
        </div>
      </a>

      <!-- Masaüstü Navigasyon -->
      <nav class="hidden lg:flex items-center gap-6 text-sm font-medium">
        <a href="/" class="text-ink-300 hover:text-white transition-colors">Ana Sayfa</a>

        {menuGroups.map((group) => (
          <div class="relative group py-5">
            {group.href && group.href !== "#" ? (
              <a href={group.href} class="flex items-center gap-1.5 text-ink-300 hover:text-white transition-colors">
                <span>{group.label}</span>
                <span class="text-[10px] opacity-70 group-hover:rotate-180 transition-transform duration-200">▼</span>
              </a>
            ) : (
              <span class="flex items-center gap-1.5 text-ink-300 hover:text-white transition-colors cursor-default">
                <span>{group.label}</span>
                <span class="text-[10px] opacity-70 group-hover:rotate-180 transition-transform duration-200">▼</span>
              </span>
            )}
            <div class="absolute left-0 top-full pt-1 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
              <div class="bg-white rounded-2xl shadow-2xl border border-ink-100 p-2 text-ink-800 space-y-1">
                {group.items.map((item: any) => (
                  <a href={item.href} class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-semibold hover:bg-brand-50 text-ink-700 hover:text-brand-900 transition-colors">
                    <span class="text-sm shrink-0">{item.icon}</span>
                    <span>{item.title}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))}

        <a href="/iletisim" class="px-4 py-2 bg-brand-700 hover:bg-brand-800 text-white font-bold rounded-xl transition-colors shadow-sm text-xs shrink-0">İletişim</a>
      </nav>

      <!-- Mobil Menü Butonu -->
      <button
        id="mobile-menu-button"
        type="button"
        class="lg:hidden p-2 text-ink-300 hover:bg-ink-800 rounded-lg transition-colors"
        aria-label="Mobil Menüyü Aç"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </div>
  </div>

  <!-- Mobil Menü Paneli -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-ink-800 bg-ink-900">
    <div class="px-4 py-4 space-y-1">
      <a href="/" class="block px-3 py-3 rounded-xl text-sm font-semibold text-ink-300 hover:bg-ink-800 hover:text-white">Ana Sayfa</a>
      {menuGroups.map((group, i) => (
        <div class="border-t border-ink-800/60 pt-1 mt-1">
          <div class="flex items-center justify-between px-3 py-3">
            {group.href && group.href !== "#" ? (
              <a href={group.href} class="text-sm font-semibold text-ink-300 hover:text-white flex-1">{group.label}</a>
            ) : (
              <span class="text-sm font-semibold text-ink-300 flex-1">{group.label}</span>
            )}
            <button 
              type="button" 
              class="mobile-accordion-trigger p-1 text-ink-300 hover:text-white"
              aria-label={`${group.label} alt menüsünü aç/kapat`}
              aria-expanded="false"
              aria-controls={`mobile-submenu-${i}`}
            >
              <span class="text-[10px] opacity-70 transition-transform duration-200 inline-block">▼</span>
            </button>
          </div>
          <div id={`mobile-submenu-${i}`} class="mobile-submenu hidden pl-3 pb-1">
            {group.items.map((item: any) => (
              <a href={item.href} class="block px-3 py-2.5 text-xs font-semibold text-ink-300 hover:text-white">{item.title}</a>
            ))}
          </div>
        </div>
      ))}
      <a href="/iletisim" class="block mt-4 px-4 py-3 bg-brand-700 text-white font-bold rounded-xl text-center text-sm">İletişim</a>
    </div>
  </div>
</header>

<script>
  function setupNavbar() {
    const btn = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');

    if (btn && menu) {
      btn.onclick = () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', (!isExpanded).toString());
        btn.setAttribute('aria-label', isExpanded ? 'Mobil Menüyü Aç' : 'Mobil Menüyü Kapat');
        menu.classList.toggle('hidden');
      };
    }

    const triggers = document.querySelectorAll('.mobile-accordion-trigger');
    triggers.forEach((trigger) => {
      (trigger as HTMLElement).onclick = () => {
        const parentDiv = trigger.closest('div.flex');
        const submenu = parentDiv?.nextElementSibling;
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
        
        trigger.setAttribute('aria-expanded', (!isExpanded).toString());
        
        const arrow = trigger.querySelector('span');
        if (arrow) {
          arrow.classList.toggle('rotate-180', !isExpanded);
        }

        if (submenu) {
          submenu.classList.toggle('hidden');
        }
      };
    });
  }

  setupNavbar();
  document.addEventListener('astro:page-load', setupNavbar);
</script>